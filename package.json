    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "wecom",
    "wechat-work",
    "webhook",
    "notification"
  ],
  "license": "MIT",
  "author": "lunch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luccion/dsh-plugin-wecom-notify.git"
  },
  "bugs": {
    "url": "https://github.com/luccion/dsh-plugin-wecom-notify/issues"
  },
  "homepage": "https://github.com/luccion/dsh-plugin-wecom-notify#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/run.mjs && node test/apply.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
